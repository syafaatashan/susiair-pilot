# Backend port. Hosting platforms usually inject PORT themselves.
PORT=3000

# Secret used to sign the login JWT. Change it for any real deployment.
JWT_SECRET=change-me-in-production

# Overrides the "today" reference date used by all endpoints.
# Left unset, the app uses the `today` field shipped inside each dataset
# (schedules: 2026-05-15, documents: 2026-05-31). The brief says treat today
# as 15 May 2026; set APP_TODAY=2026-05-15 to force that everywhere.
# APP_TODAY=2026-05-15
