# Backend port. Hosting platforms usually inject PORT themselves.
PORT=3000

# Secret used to sign the login JWT.
# REQUIRED when NODE_ENV=production - the API refuses to boot without it, because
# the committed fallback secret would let anyone forge a token. Locally it falls
# back to a development secret and logs a warning.
JWT_SECRET=change-me-in-production

# THE single "today" reference date, shared by flight-hours, documents and schedules.
# Default: 2026-05-15 - the date the brief mandates ("Treat today as 15 May 2026").
# The documents dataset ships its own today of 2026-05-31; set
#   APP_TODAY=2026-05-31
# only if you deliberately want that reading (licence then shows as expired).
# APP_TODAY=2026-05-15

# Set to production on a real deployment. Makes a missing JWT_SECRET fatal.
# NODE_ENV=production